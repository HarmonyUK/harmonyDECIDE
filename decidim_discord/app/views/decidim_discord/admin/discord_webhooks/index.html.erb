<div class="card">
  <div class="card-divider">
    <div class="card-title--with-button">
      <h2 class="card-title">
        <%= t("discord_webhooks.index.title", scope: "decidim.decidim_discord.admin") %>
      </h2>
      <div class="card-title__button">
        <%= link_to t("discord_webhooks.index.new_webhook", scope: "decidim.decidim_discord.admin"), 
                    new_admin_discord_webhook_path, 
                    class: "button button__sm button__primary" %>
      </div>
    </div>
  </div>

  <div class="card-section">
    <p class="text-muted"><%= t("discord_webhooks.index.description", scope: "decidim.decidim_discord.admin") %></p>
    
    <% if @webhooks.any? %>
      <div class="table-scroll">
        <table class="table-list">
          <thead>
            <tr>
              <th><%= t("table.name", scope: "decidim.decidim_discord.admin") %></th>
              <th><%= t("table.event_types", scope: "decidim.decidim_discord.admin") %></th>
              <th><%= t("table.status", scope: "decidim.decidim_discord.admin") %></th>
              <th><%= t("table.created_at", scope: "decidim.decidim_discord.admin") %></th>
              <th class="table-list__actions"><%= t("table.actions", scope: "decidim.decidim_discord.admin") %></th>
            </tr>
          </thead>
          <tbody>
            <% @webhooks.each do |webhook| %>
              <tr>
                <td>
                  <strong><%= webhook.name %></strong><br>
                  <small class="text-muted"><%= truncate(webhook.webhook_url, length: 50) %></small>
                </td>
                <td>
                  <% webhook.event_types.each do |event_type| %>
                    <span class="label secondary"><%= t("event_types.#{event_type}", scope: "decidim.decidim_discord.admin", default: event_type.titleize) %></span>
                  <% end %>
                </td>
                <td>
                  <span class="<%= webhook.active? ? 'success' : 'alert' %> label">
                    <%= webhook.active? ? t("active", scope: "decidim.decidim_discord.admin") : t("inactive", scope: "decidim.decidim_discord.admin") %>
                  </span>
                </td>
                <td><%= l webhook.created_at, format: :short %></td>
                <td class="table-list__actions">
                  <%= icon_link_to "eye-line", 
                                  admin_discord_webhook_webhook_logs_path(webhook), 
                                  t("buttons.logs", scope: "decidim.decidim_discord.admin"),
                                  class: "action-icon--logs" %>
                  
                  <%= icon_link_to "pencil-line", 
                                  edit_admin_discord_webhook_path(webhook), 
                                  t("buttons.edit", scope: "decidim.decidim_discord.admin"),
                                  class: "action-icon--edit" %>
                  
                  <%= icon_link_to webhook.active? ? "check-double-fill" : "x", 
                                  toggle_admin_discord_webhook_path(webhook), 
                                  t("buttons.toggle", scope: "decidim.decidim_discord.admin"),
                                  method: :post, 
                                  class: "action-icon--toggle" %>
                  
                  <%= icon_link_to "user-voice-line", 
                                  test_admin_discord_webhook_path(webhook), 
                                  t("buttons.test", scope: "decidim.decidim_discord.admin"),
                                  method: :post, 
                                  class: "action-icon--test" %>
                  
                  <%= icon_link_to "delete-bin-line", 
                                  admin_discord_webhook_path(webhook), 
                                  t("buttons.delete", scope: "decidim.decidim_discord.admin"),
                                  method: :delete, 
                                  class: "action-icon--remove",
                                  data: { confirm: t("confirm.delete", scope: "decidim.decidim_discord.admin") } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="callout warning">
        <p><%= t("discord_webhooks.index.no_webhooks", scope: "decidim.decidim_discord.admin") %></p>
      </div>
    <% end %>
  </div>
</div>
