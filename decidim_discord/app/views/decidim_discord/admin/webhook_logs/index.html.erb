<div class="card">
  <div class="card-divider">
    <div class="card-title">
      <h2 class="h3">
        <%= link_to admin_discord_webhooks_path, class: "button button__sm button__secondary" do %>
          ← <%= t("buttons.back", scope: "decidim.decidim_discord.admin") %>
        <% end %>
        <%= t(".title", scope: "decidim.decidim_discord.admin") %>
      </h2>
      <p class="text-muted">
        <%= t(".description", webhook_name: @webhook.name, scope: "decidim.decidim_discord.admin") %>
      </p>
    </div>
  </div>

  <div class="card-section">
    <% if logs.any? %>
      <div class="table-scroll">
        <table class="table-list">
          <thead>
            <tr>
              <th><%= t("table.event_type", scope: "decidim.decidim_discord.admin") %></th>
              <th><%= t("table.status_code", scope: "decidim.decidim_discord.admin") %></th>
              <th><%= t("table.success", scope: "decidim.decidim_discord.admin") %></th>
              <th><%= t("table.created_at", scope: "decidim.decidim_discord.admin") %></th>
              <th class="table-list__actions"><%= t("table.actions", scope: "decidim.decidim_discord.admin") %></th>
            </tr>
          </thead>
          <tbody>
            <% logs.each do |log| %>
              <tr class="<%= log.success? ? '' : 'table-list__row--error' %>">
                <td><code><%= t("event_types.#{log.event_type}", scope: "decidim.decidim_discord.admin", default: log.event_type.titleize) %></code></td>
                <td><code><%= log.status %></code></td>
                <td>
                  <span class="<%= log.success? ? 'success' : 'alert' %> label">
                    <%= log.success? ? "Success" : "Failed" %>
                  </span>
                </td>
                <td><%= l log.created_at, format: :short %></td>
                <td class="table-list__actions">
                  <%= icon_link_to "eye-line",
                                  admin_discord_webhook_webhook_log_path(@webhook, log),
                                  t("buttons.show", scope: "decidim.decidim_discord.admin"),
                                  class: "action-icon--show" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="callout warning">
        <p><%= t(".no_logs", scope: "decidim.decidim_discord.admin") %></p>
      </div>
    <% end %>
  </div>
</div>
