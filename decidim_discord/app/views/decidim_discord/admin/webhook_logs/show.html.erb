<div class="row column">
  <h1 class="section-heading">
    <%= link_to t("buttons.back", scope: "decidim.decidim_discord.admin"),
                admin_discord_webhook_webhook_logs_path(@webhook),
                class: "button button--back" %>
    <%= t(".title", scope: "decidim.decidim_discord.admin") %>
  </h1>
</div>

<div class="card">
  <div class="card-section">
    <div class="row">
      <div class="columns large-6">
        <div class="field">
          <label><strong><%= t("table.event_type", scope: "decidim.decidim_discord.admin") %></strong></label>
          <p>
            <code><%= t("event_types.#{@log.event_type}", scope: "decidim.decidim_discord.admin", default: @log.event_type.titleize) %></code>
          </p>
        </div>

        <div class="field">
          <label><strong><%= t("table.status_code", scope: "decidim.decidim_discord.admin") %></strong></label>
          <p><code><%= @log.status %></code></p>
        </div>

        <div class="field">
          <label><strong><%= t("table.success", scope: "decidim.decidim_discord.admin") %></strong></label>
          <p>
            <span class="label <%= @log.success? ? 'label--success' : 'label--alert' %>">
              <%= @log.success? ? "Success" : "Failed" %>
            </span>
          </p>
        </div>
      </div>

      <div class="columns large-6">
        <div class="field">
          <label><strong><%= t("table.created_at", scope: "decidim.decidim_discord.admin") %></strong></label>
          <p><%= l @log.created_at, format: :long %></p>
        </div>

        <div class="field">
          <label><strong>Webhook Name</strong></label>
          <p><%= @webhook.name %></p>
        </div>
      </div>
    </div>

    <div class="field">
      <label><strong><%= t("table.response_body", scope: "decidim.decidim_discord.admin") %></strong></label>
      <div class="code-block" style="background: #f5f5f5; padding: 1rem; border-radius: 4px; max-height: 300px; overflow-y: auto;">
        <pre style="margin: 0; font-size: 0.875rem;"><code><%= truncate(@log.response_body, length: 2000) %></code></pre>
      </div>
    </div>
  </div>

  <div class="actions">
    <%= link_to t("buttons.back", scope: "decidim.decidim_discord.admin"),
               admin_discord_webhook_webhook_logs_path(@webhook),
               class: "button button__lg button__secondary" %>
  </div>
</div>
